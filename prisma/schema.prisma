generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────

enum UserRole {
  STUDENT
  DRIVER
  ADMIN
}

enum RideType {
  SOLO_QUICK_CAB
  SHARED_SHUTTLE
}

enum RideStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionStatus {
  DRAFT
  COMPLETED
}

enum SafetyAlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  ABANDONED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

// ─── Commission system enums ─────────────────────────

enum EarningStatus {
  ACCRUED
  REVERSED
}

enum EarningPayoutStatus {
  UNPAID
  PAID
}

enum CommissionEntryType {
  ACCRUAL
  ADJUSTMENT
  REVERSAL
}

enum CommissionEntryStatus {
  OUTSTANDING
  RESERVED
  SETTLED
  REVERSED
}

enum SettlementStatus {
  PREPARED
  TRANSFERRING
  SUCCESSFUL
  FAILED
  BLOCKED
  CANCELLED
}

enum SettlementReconciliationStatus {
  UNRECONCILED
  RECONCILED
  NEEDS_REVIEW
}

// ─── Models ───────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  name          String
  phone         String
  profileImage  String?   @map("profile_image")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  student          Student?
  driver           Driver?
  notifications    Notification[]
  safetyAlerts     SafetyAlert[]   @relation("UserSafetyAlerts")
  rideStatusHistory RideStatusHistory[]
  preferences      UserPreference?
  passwordHintQuestion  String?  @map("password_hint_question")
  passwordHintAnswer    String?  @map("password_hint_answer")
  passwordResetTokens PasswordResetToken[]
  payments           Payment[]

  @@map("users")
}

model Student {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  matricNo    String  @unique @map("matric_no")
  university  String  @default("University")

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips       Trip[]

  @@map("students")
}

model Driver {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @unique @map("user_id") @db.Uuid
  driverId        String  @unique @map("driver_id")
  isOnline        Boolean @default(false) @map("is_online")
  avgRating       Float   @default(0) @map("avg_rating")
  totalTrips      Int     @default(0) @map("total_trips")

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?
  inspections     VehicleInspection[]
  assignedTrips   Trip[]
  ratings         Rating[]
  earnings        DriverEarning[]
  commissionEntries CommissionLedgerEntry[]

  @@map("drivers")
}

model Vehicle {
  id          String  @id @default(uuid()) @db.Uuid
  driverId    String  @unique @map("driver_id") @db.Uuid
  make        String
  model       String
  color       String
  licensePlate String @map("license_plate")

  driver      Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

model CampusLocation {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  lat   Float?
  lng   Float?

  pickupTrips     Trip[] @relation("PickupLocation")
  dropoffTrips    Trip[] @relation("DropoffLocation")

  @@map("campus_locations")
}

model Trip {
  id                String      @id @default(uuid()) @db.Uuid
  studentId         String      @map("student_id") @db.Uuid
  driverId          String?     @map("driver_id") @db.Uuid
  pickupLocationId  String      @map("pickup_location_id") @db.Uuid
  dropoffLocationId String      @map("dropoff_location_id") @db.Uuid
  rideType          RideType    @map("ride_type")
  passengerCount    Int         @map("passenger_count")
  totalFare         Float       @map("total_fare")
  appCharge         Float       @default(10) @map("platform_fee")
  driverPayoutAmount Float      @default(0) @map("driver_payout_amount")
  driverEarnings    Float       @default(0) @map("driver_earnings")
  status            RideStatus  @default(PENDING)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  student         Student          @relation(fields: [studentId], references: [id])
  driver          Driver?          @relation(fields: [driverId], references: [id])
  pickupLocation  CampusLocation   @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation CampusLocation   @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])
  passengers      TripPassenger[]
  statusHistory   RideStatusHistory[]
  ratings         Rating[]
  safetyAlerts    SafetyAlert[]
  payments        Payment[]
  earning         DriverEarning?

  @@index([status])
  @@index([driverId])
  @@index([studentId])
  @@index([status, driverId])
  @@index([status, studentId])
  @@index([createdAt])
  @@map("trips")
}

model TripPassenger {
  id        String  @id @default(uuid()) @db.Uuid
  tripId    String  @map("trip_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  seatNo    Int?    @map("seat_no")

  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("trip_passengers")
}

model VehicleInspection {
  id              String            @id @default(uuid()) @db.Uuid
  driverId        String            @map("driver_id") @db.Uuid
  brakes          Boolean           @default(false)
  tires           Boolean           @default(false)
  lights          Boolean           @default(false)
  interiorClean   Boolean           @default(false) @map("interior_clean")
  noTrash         Boolean           @default(false) @map("no_trash")
  fireExtinguisher Boolean          @default(false) @map("fire_extinguisher")
  firstAidKit     Boolean           @default(false) @map("first_aid_kit")
  fuelBattery     Boolean           @default(false) @map("fuel_battery_above_50")
  status          InspectionStatus  @default(DRAFT)
  createdAt       DateTime          @default(now()) @map("created_at")

  driver          Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("vehicle_inspections")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model SafetyAlert {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  tripId        String?           @map("trip_id") @db.Uuid
  latitude      Float?
  longitude     Float?
  status        SafetyAlertStatus @default(PENDING)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user          User              @relation("UserSafetyAlerts", fields: [userId], references: [id])
  trip          Trip?             @relation(fields: [tripId], references: [id])

  @@map("safety_alerts")
}

model RideStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  from      RideStatus
  to        RideStatus
  createdAt DateTime @default(now()) @map("created_at")

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("ride_status_history")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int
  feedback  String?
  createdAt DateTime @default(now()) @map("created_at")

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@unique([tripId, userId])
  @@map("ratings")
}

model UserPreference {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  theme     String  @default("system")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model PushToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  token       String   @unique
  platform    String   @default("web")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")

  @@index([userId])
  @@map("push_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  method    String   // "email" or "phone"
  contact   String   // the email or phone used to request
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Payment ──────────────────────────────────────────

model Payment {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  tripId            String         @map("trip_id") @db.Uuid
  reference         String         @unique @db.VarChar(100)
  passengerCount    Int            @map("passenger_count")
  rideFare          Float          @map("ride_fare")
  platformFee       Float          @map("platform_fee")
  totalAmount       Float          @map("total_amount")
  currency          String         @default("NGN")
  status            PaymentStatus  @default(PENDING)
  provider          String?
  providerReference String?        @map("provider_reference") @db.VarChar(255)
  providerMetadata  Json?          @map("provider_metadata")
  paidAt            DateTime?      @map("paid_at")
  failureReason     String?        @map("failure_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id])
  trip  Trip       @relation(fields: [tripId], references: [id])
  payouts Payout[] @relation("PaymentPayouts")
  earning DriverEarning?

  @@index([userId])
  @@index([tripId])
  @@index([reference])
  @@index([status])
  @@index([provider])
  @@map("payments")
}

model DriverPaymentAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  driverId            String   @unique @map("driver_id") @db.Uuid
  provider            String
  bankCode            String?  @map("bank_code") @db.VarChar(20)
  bankName            String?  @map("bank_name") @db.VarChar(100)
  accountNumber       String?  @map("account_number") @db.VarChar(30)
  accountName         String?  @map("account_name") @db.VarChar(100)
  providerRecipientId String?  @map("provider_recipient_id") @db.VarChar(100)
  verificationStatus  String   @default("PENDING") @map("verification_status")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("driver_payment_accounts")
}

model Payout {
  id                 String        @id @default(uuid()) @db.Uuid
  tripId             String        @map("trip_id") @db.Uuid
  driverId           String        @map("driver_id") @db.Uuid
  paymentId          String        @map("payment_id") @db.Uuid
  provider           String
  providerReference  String?       @map("provider_reference") @db.VarChar(255)
  amount             Float         @map("amount")
  status             PayoutStatus  @default(PENDING)
  failureReason      String?       @map("failure_reason")
  initiatedAt        DateTime?     @map("initiated_at")
  completedAt        DateTime?     @map("completed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  payment            Payment       @relation("PaymentPayouts", fields: [paymentId], references: [id])

  @@index([tripId])
  @@index([driverId])
  @@index([paymentId])
  @@index([provider])
  @@index([status])
  @@map("payouts")
}

// ─── School commission system ────────────────────────
//
// Money columns in the commission system are stored as INTEGER KOBO so all
// financial arithmetic is exact. The legacy Fare/Payment columns remain NGN
// floats and are converted once (Math.round(naira * 100)) at the boundary.
//
// Ledger entries are append-only: corrections are new ADJUSTMENT/REVERSAL
// entries, never edits to committed financial records.

model DriverEarning {
  id                   String            @id @default(uuid()) @db.Uuid
  driverId             String            @map("driver_id") @db.Uuid
  tripId               String            @unique @map("trip_id") @db.Uuid
  paymentId            String?           @unique @map("payment_id") @db.Uuid
  paymentReference     String?           @map("payment_reference") @db.VarChar(100)
  currency             String            @default("NGN")
  eligibleAmountKobo   Int               @map("eligible_amount_kobo")
  commissionRateBps    Int               @map("commission_rate_bps")
  commissionAmountKobo Int               @map("commission_amount_kobo")
  netAmountKobo        Int               @map("net_amount_kobo")
  // Business-day marker (UTC midnight of the business day in businessTimezone)
  earningDate          DateTime          @map("earning_date")
  businessTimezone     String            @default("Africa/Lagos") @map("business_timezone")
  status               EarningStatus     @default(ACCRUED)
  payoutStatus         EarningPayoutStatus @default(UNPAID) @map("payout_status")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  driver          Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  trip            Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payment         Payment?                @relation(fields: [paymentId], references: [id])
  ledgerEntries   CommissionLedgerEntry[]

  @@index([driverId, earningDate])
  @@index([earningDate])
  @@index([status])
  @@map("driver_earnings")
}

model CommissionLedgerEntry {
  id                String                @id @default(uuid()) @db.Uuid
  driverId          String                @map("driver_id") @db.Uuid
  earningId         String?               @map("earning_id") @db.Uuid
  settlementId      String?               @map("settlement_id") @db.Uuid
  amountKobo        Int                   @map("amount_kobo")
  commissionRateBps Int                   @map("commission_rate_bps")
  // Business day this commission belongs to (UTC midnight marker)
  periodDate        DateTime              @map("period_date")
  entryType         CommissionEntryType   @map("entry_type")
  status            CommissionEntryStatus @default(OUTSTANDING)
  reversalOfId      String?               @map("reversal_of_id") @db.Uuid
  note              String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  driver      Driver                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  earning     DriverEarning?          @relation(fields: [earningId], references: [id])
  settlement  CommissionSettlement?   @relation(fields: [settlementId], references: [id])

  @@index([status, periodDate])
  @@index([driverId, periodDate])
  @@index([settlementId])
  @@map("commission_ledger_entries")
}

model CommissionSettlement {
  id                    String                          @id @default(uuid()) @db.Uuid
  reference             String                          @unique @db.VarChar(100)
  // Business day being settled (UTC midnight marker)
  periodDate            DateTime                        @map("period_date")
  totalAmountKobo       Int                             @map("total_amount_kobo")
  entryCount            Int                             @default(0) @map("entry_count")
  // Recipient snapshot (masked for display; full account stays server-side)
  recipientLabel        String?                         @map("recipient_label") @db.VarChar(120)
  recipientBankCode     String?                         @map("recipient_bank_code") @db.VarChar(20)
  recipientAccountNumber String?                        @map("recipient_account_number") @db.VarChar(30)
  provider              String                          @default("FLUTTERWAVE")
  providerReference     String?                         @map("provider_reference") @db.VarChar(255)
  transferStatus        SettlementStatus                @default(PREPARED) @map("transfer_status")
  reconciliationStatus  SettlementReconciliationStatus  @default(UNRECONCILED) @map("reconciliation_status")
  failureReason         String?                         @map("failure_reason")
  // Stable idempotency key — the same period can never be reserved twice
  idempotencyKey        String                          @unique @map("idempotency_key") @db.VarChar(200)
  initiatedAt           DateTime?                       @map("initiated_at")
  confirmedAt           DateTime?                       @map("confirmed_at")
  failedAt              DateTime?                       @map("failed_at")
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")

  entries CommissionLedgerEntry[]

  @@index([transferStatus])
  @@index([periodDate])
  @@map("commission_settlements")
}

model CommissionConfig {
  // Singleton row (id = 1)
  id                     Int      @id @default(1)
  // 5% expressed in basis points (500 bps = 5.00%)
  commissionRateBps      Int      @default(500) @map("commission_rate_bps")
  businessTimezone       String   @default("Africa/Lagos") @map("business_timezone")
  // Local hour (0-23) at which the daily settlement cycle runs
  settlementHourLocal    Int      @default(1) @map("settlement_hour_local")
  autoSettlementEnabled  Boolean  @default(false) @map("auto_settlement_enabled")
  manualApprovalRequired Boolean  @default(true) @map("manual_approval_required")
  minSettlementKobo      Int      @default(0) @map("min_settlement_kobo")
  recipientBankCode      String?  @map("recipient_bank_code") @db.VarChar(20)
  recipientBankName      String?  @map("recipient_bank_name") @db.VarChar(100)
  recipientAccountNumber String?  @map("recipient_account_number") @db.VarChar(30)
  recipientAccountName   String?  @map("recipient_account_name") @db.VarChar(100)
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("commission_config")
}
