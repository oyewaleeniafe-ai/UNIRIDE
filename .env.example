[TEMPLATE]
# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/campuscab?sslmode=require"

# Authentication
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="https://campuscab-pi.vercel.app"

# App URL
NEXT_PUBLIC_APP_URL="https://campuscab-pi.vercel.app"

# Email (Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Campus Cab <notifications@campuscab.app>"

# SOS Safety Email
SOS_SECURITY_EMAIL="security@campuscab.app"

# Payments — PalmPay (active provider, server-side only)
PALMPAY_MERCHANT_ID=
PALMPAY_SECRET_KEY=
PALMPAY_WEBHOOK_SECRET=
PALMPAY_WEBHOOK_SIGNATURE_HEADER=x-palmpay-signature
PALMPAY_BASE_URL=https://open-api.palmpay.com
PALMPAY_PAYOUT_ENABLED=

# Payments — OPay (active provider, server-side only)
OPAY_MERCHANT_ID=
OPAY_SECRET_KEY=
OPAY_WEBHOOK_SECRET=
OPAY_WEBHOOK_SIGNATURE_HEADER=x-opay-signature
OPAY_BASE_URL=https://opay.api
OPAY_PAYOUT_ENABLED=
