[TEMPLATE]
# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/campuscab?sslmode=require"

# Authentication
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="https://campuscab-pi.vercel.app"

# App URL
NEXT_PUBLIC_APP_URL="https://campuscab-pi.vercel.app"

# Email (Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Campus Cab <notifications@campuscab.app>"

# SOS Safety Email
SOS_SECURITY_EMAIL="security@campuscab.app"

# Payments — Flutterwave (the only payment provider)
# Public docs: https://developer.flutterwave.com/docs
# Live site callback URL is /api/payments/verify?reference=<tx_ref>
FLUTTERWAVE_SECRET_KEY="FLWXXXXXXXX"
FLUTTERWAVE_WEBHOOK_SECRET="your_webhook_secret_hash"

# Optional: enable Flutterwave transfers (driver payouts AND the school's
# commission settlement) only after the merchant account is approved for
# transfers (KYC, server IP whitelist, Transfers API enabled on the dashboard).
# Set to "1" only after approval. While unset, no money is ever moved.
FLUTTERWAVE_TRANSFERS_ENABLED=

# ── School commission settlement ───────────────────────────────
# Secret for the scheduled settlement job (Vercel Cron → /api/commission/settlements/run).
# Vercel sets CRON_SECRET automatically on paid plans; otherwise set your own
# random value here and use it as "Authorization: Bearer <value>" or the
# "x-settlement-secret" header. Never commit a real value.
CRON_SECRET=""

# Optional alternative secret for external schedulers (cron-job.org, GitHub
# Actions, a worker). Leave empty to rely on CRON_SECRET only.
COMMISSION_SETTLEMENT_SECRET=""

# The commission rate, business timezone, minimum settlement amount and the
# school's verified bank account are NOT environment variables — they are
# stored in the `commission_config` table and edited by an ADMIN at
# /admin/commission. That keeps the rate auditable and changeable without a
# redeploy.
