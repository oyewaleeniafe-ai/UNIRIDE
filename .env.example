[TEMPLATE]
# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/campuscab?sslmode=require"

# Authentication
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="https://campuscab-pi.vercel.app"

# App URL
NEXT_PUBLIC_APP_URL="https://campuscab-pi.vercel.app"

# Email (Resend)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Campus Cab <notifications@campuscab.app>"

# SOS Safety Email
SOS_SECURITY_EMAIL="security@campuscab.app"

# Payments — Flutterwave (the only payment provider)
# Public docs: https://developer.flutterwave.com/docs
# Live site callback URL is /api/payments/verify?reference=<tx_ref>
FLUTTERWAVE_SECRET_KEY="FLWXXXXXXXX"
FLUTTERWAVE_WEBHOOK_SECRET="your_webhook_secret_hash"
FLUTTERWAVE_TRANSFERS_ENABLED=

# Optional: enable driver payouts off-chain only after the Flutterwave
# merchant account is approved for transfers (KYC, IP whitelist, Transfers API).
