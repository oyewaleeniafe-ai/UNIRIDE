# Base URL of the CampusCab backend (the existing Next.js app).
# Production: leave this out or use https://campuscab-pi.vercel.app
# Local development: use your computer's LAN IP so a physical phone can reach it,
# e.g. EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://campuscab-pi.vercel.app

# NOTE: only EXPO_PUBLIC_* values are embedded in the app bundle.
# Never put FLUTTERWAVE_SECRET_KEY, DATABASE_URL, AUTH_SECRET or any other
# server secret here — they belong to the Next.js backend only.
