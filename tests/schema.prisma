generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/test-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("STUDENT")
  name          String
  phone         String
  profileImage  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student          Student?
  driver           Driver?
  notifications    Notification[]
  safetyAlerts     SafetyAlert[]   @relation("UserSafetyAlerts")
  rideStatusHistory RideStatusHistory[]
  preferences      UserPreference?
  passwordHintQuestion  String?
  passwordHintAnswer    String?
  passwordResetTokens PasswordResetToken[]
  auditLogs        AuditLog[]
  payments         Payment[]
}

model Student {
  id          String  @id @default(uuid())
  userId      String  @unique
  matricNo    String  @unique
  university  String  @default("University")

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips       Trip[]
}

model Driver {
  id              String  @id @default(uuid())
  userId          String  @unique
  driverId        String  @unique
  isOnline        Boolean @default(false)
  avgRating       Float   @default(0)
  totalTrips      Int     @default(0)

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?
  inspections     VehicleInspection[]
  assignedTrips   Trip[]
  ratings         Rating[]
  paymentAccount  DriverPaymentAccount?
  earnings        DriverEarning[]
  commissionEntries CommissionLedgerEntry[]
}

model Vehicle {
  id          String  @id @default(uuid())
  driverId    String  @unique
  make        String
  model       String
  color       String
  licensePlate String

  driver      Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model CampusLocation {
  id    String @id @default(uuid())
  name  String @unique
  lat   Float?
  lng   Float?

  pickupTrips     Trip[] @relation("PickupLocation")
  dropoffTrips    Trip[] @relation("DropoffLocation")
}

model Trip {
  id                String      @id @default(uuid())
  studentId         String
  driverId          String?
  pickupLocationId  String
  dropoffLocationId String
  rideType          String      @default("SOLO_QUICK_CAB")
  passengerCount    Int
  totalFare         Float
  appCharge         Float       @default(10)
  driverPayoutAmount Float      @default(0)
  driverEarnings    Float       @default(0)
  status            String      @default("PENDING")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  student         Student          @relation(fields: [studentId], references: [id])
  driver          Driver?          @relation(fields: [driverId], references: [id])
  pickupLocation  CampusLocation   @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation CampusLocation   @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])
  passengers      TripPassenger[]
  statusHistory   RideStatusHistory[]
  ratings         Rating[]
  safetyAlerts    SafetyAlert[]
  payments        Payment[]
  earning         DriverEarning?

  @@index([status])
  @@index([driverId])
  @@index([studentId])
}

model TripPassenger {
  id        String  @id @default(uuid())
  tripId    String
  userId    String
  seatNo    Int?

  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model VehicleInspection {
  id              String   @id @default(uuid())
  driverId        String
  brakes          Boolean  @default(false)
  tires           Boolean  @default(false)
  lights          Boolean  @default(false)
  interiorClean   Boolean  @default(false)
  noTrash         Boolean  @default(false)
  fireExtinguisher Boolean @default(false)
  firstAidKit     Boolean  @default(false)
  fuelBattery     Boolean  @default(false)
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())

  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SafetyAlert {
  id            String    @id @default(uuid())
  userId        String
  tripId        String?
  latitude      Float?
  longitude     Float?
  status        String    @default("PENDING")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation("UserSafetyAlerts", fields: [userId], references: [id])
  trip          Trip?     @relation(fields: [tripId], references: [id])
}

model RideStatusHistory {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  from      String
  to        String
  createdAt DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Rating {
  id        String   @id @default(uuid())
  tripId    String
  driverId  String
  userId    String
  score     Int
  feedback  String?
  createdAt DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id])

  @@unique([tripId, userId])
}

model UserPreference {
  id        String  @id @default(uuid())
  userId    String  @unique
  theme     String  @default("system")
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  method    String
  contact   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  tripId            String
  reference         String   @unique
  passengerCount    Int
  rideFare          Float
  platformFee       Float
  totalAmount       Float
  currency          String   @default("NGN")
  status            String   @default("PENDING")
  provider          String?
  providerReference String?
  providerMetadata  String?
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payouts Payout[]
  earning DriverEarning?

  @@index([tripId])
  @@index([status])
}

model DriverPaymentAccount {
  id                  String   @id @default(uuid())
  driverId            String   @unique
  provider            String
  bankCode            String?
  bankName            String?
  accountNumber       String?
  accountName         String?
  providerRecipientId String?
  verificationStatus  String   @default("PENDING")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Payout {
  id                String   @id @default(uuid())
  tripId            String
  driverId          String
  paymentId         String
  provider          String
  providerReference String?
  amount            Float
  status            String   @default("PENDING")
  failureReason     String?
  initiatedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── School commission system (SQLite mirror of prisma/schema.prisma) ───
// Status/type columns are plain strings here to match this test schema's style.
// Money columns are INTEGER KOBO, same as production.

model DriverEarning {
  id                   String   @id @default(uuid())
  driverId             String
  tripId               String   @unique
  paymentId            String?  @unique
  paymentReference     String?
  currency             String   @default("NGN")
  eligibleAmountKobo   Int
  commissionRateBps    Int
  commissionAmountKobo Int
  netAmountKobo        Int
  earningDate          DateTime
  businessTimezone     String   @default("Africa/Lagos")
  status               String   @default("ACCRUED")
  payoutStatus         String   @default("UNPAID")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payment       Payment? @relation(fields: [paymentId], references: [id])
  ledgerEntries CommissionLedgerEntry[]

  @@index([driverId, earningDate])
  @@index([earningDate])
  @@index([status])
}

model CommissionLedgerEntry {
  id                String   @id @default(uuid())
  driverId          String
  earningId         String?
  settlementId      String?
  amountKobo        Int
  commissionRateBps Int
  periodDate        DateTime
  entryType         String   @default("ACCRUAL")
  status            String   @default("OUTSTANDING")
  reversalOfId      String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driver     Driver                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  earning    DriverEarning?        @relation(fields: [earningId], references: [id])
  settlement CommissionSettlement? @relation(fields: [settlementId], references: [id])

  @@index([status, periodDate])
  @@index([driverId, periodDate])
  @@index([settlementId])
}

model CommissionSettlement {
  id                     String   @id @default(uuid())
  reference              String   @unique
  periodDate             DateTime
  totalAmountKobo        Int
  entryCount             Int      @default(0)
  recipientLabel         String?
  recipientBankCode      String?
  recipientAccountNumber String?
  provider               String   @default("FLUTTERWAVE")
  providerReference      String?
  transferStatus         String   @default("PREPARED")
  reconciliationStatus   String   @default("UNRECONCILED")
  failureReason          String?
  idempotencyKey         String   @unique
  initiatedAt            DateTime?
  confirmedAt            DateTime?
  failedAt               DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  entries CommissionLedgerEntry[]

  @@index([transferStatus])
  @@index([periodDate])
}

model CommissionConfig {
  id                     Int      @id @default(1)
  commissionRateBps      Int      @default(500)
  businessTimezone       String   @default("Africa/Lagos")
  settlementHourLocal    Int      @default(1)
  autoSettlementEnabled  Boolean  @default(false)
  manualApprovalRequired Boolean  @default(true)
  minSettlementKobo      Int      @default(0)
  recipientBankCode      String?
  recipientBankName      String?
  recipientAccountNumber String?
  recipientAccountName   String?
  updatedAt              DateTime @updatedAt
}
